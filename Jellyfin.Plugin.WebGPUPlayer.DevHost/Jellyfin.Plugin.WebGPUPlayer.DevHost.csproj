<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The plugin's routes, served for serve_jellyfin_web_client.sh as a server with the plugin installed serves them.
    The script builds it with WebGPUPlayerDevRoot and AddonOutputDirectory set (Directory.Build.props), so the plugin embeds the live add-on build
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Jellyfin.Plugin.WebGPUPlayer.DevHost</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin excludes these runtime assets because the server provides them; this host is the server here -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.WebGPUPlayer\Jellyfin.Plugin.WebGPUPlayer.csproj" />
  </ItemGroup>

</Project>
