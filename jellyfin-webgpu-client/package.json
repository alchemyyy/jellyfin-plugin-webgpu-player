{
  "name": "jellyfin-webgpu-client",
  "version": "0.1.0",
  "private": true,
  "description": "WebGPU Player client add-on for an unmodified Jellyfin Web",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "4.4.1",
    "@stylistic/stylelint-plugin": "3.1.3",
    "@types/escape-html": "1.0.4",
    "@webgpu/types": "0.1.71",
    "autoprefixer": "10.5.4",
    "axios": "1.18.1",
    "babel-loader": "10.1.1",
    "confusing-browser-globals": "1.0.11",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.4",
    "cssnano": "7.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "6.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-sonarjs": "3.0.7",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "material-design-icons-iconfont": "6.7.0",
    "postcss": "8.5.23",
    "postcss-loader": "8.2.1",
    "postcss-preset-env": "10.6.1",
    "postcss-scss": "4.0.9",
    "sass-embedded": "1.100.0",
    "sass-loader": "16.0.8",
    "style-loader": "4.0.0",
    "stylelint": "16.26.1",
    "stylelint-no-browser-hacks": "2.0.3",
    "stylelint-scss": "6.14.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.3.5",
    "vitest": "3.2.7",
    "webpack": "5.109.0",
    "webpack-cli": "7.2.1"
  },
  "dependencies": {
    "@jellyfin/libass-wasm": "4.2.4",
    "@jellyfin/sdk": "0.0.0-unstable.202609160935",
    "core-js": "3.49.0",
    "dompurify": "2.5.9",
    "escape-html": "1.0.3",
    "flv.js": "1.6.2",
    "libbitsub": "1.11.0",
    "lodash-es": "4.18.1",
    "screenfull": "6.0.2"
  },
  "workspaces": [
    "vendor/webgpu-player"
  ],
  "browserslist": [
    "last 2 Firefox versions",
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Safari versions",
    "iOS > 10",
    "last 2 Edge versions",
    "Chrome 27",
    "Chrome 38",
    "Chrome 47",
    "Chrome 53",
    "Chrome 56",
    "Chrome 63",
    "Edge 18",
    "Firefox ESR"
  ],
  "scripts": {
    "build": "node scripts/build-hls.js && node scripts/write-host-tsconfig.js && cross-env NODE_ENV=\"production\" webpack --config webpack.config.js",
    "build:development": "node scripts/build-hls.js && node scripts/write-host-tsconfig.js && webpack --config webpack.config.js",
    "lint": "node scripts/write-host-tsconfig.js && cd .. && eslint --concurrency=auto",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "test": "node scripts/build-hls.js && node scripts/write-host-tsconfig.js && vitest --watch=false --config vitest.config.ts",
    "typecheck": "node scripts/write-host-tsconfig.js && node scripts/typecheck.js"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
