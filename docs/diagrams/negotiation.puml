@startuml
!include ../../jellyfin-webgpu-client/vendor/webgpu-player/docs/diagrams/diagram-theme.puml

partition "1. Select a player" {
  start
  :PlaybackManager offers the item to WebGPUPlayer first (priority 0); <<$HL_BLUE>>
  if (User prefers HTML, native app shell,\nor the engine's prefilter finds no route?) then (decline)
    :Plain HTML player with the stock profile; <<$HL_AMBER>>
    stop
  endif
}

partition "2. Build the device profile" {
  if (options.isRetry?) then (retry)
    :Stock profile, never widened; <<$HL_RED>>
  else (first negotiation)
    :Adopt the stored preferences, remember the stock profile as proof,
    strip every bitrate field and condition; <<$HL_NAVY>>
    if (Custom decode on and runtime available?) then (yes)
      :Await the item's capability probes and native-media audio probe; <<$HL_BLUE>>
      :Await the GPU authorizations of the item's probe scope (5 s each); <<$HL_BLUE>>
      :augmentDeviceProfileForCustomDecode:
      DirectPlayProfiles per container rule, route CodecProfiles,
      exact item routes for Dolby Vision labels; <<$HL_GREEN>>
    else (no)
      :Bitrate-free stock profile; <<$HL_AMBER>>
    endif
  endif
}

partition "3. PlaybackInfo" {
  :The interceptor rewrites PlaybackManager's request:
  no MaxStreamingBitrate, AllowVideoStreamCopy=false for Dolby Vision; <<$HL_NAVY>>
  :The server picks DirectPlay, DirectStream, or Transcode
  (StreamBuilder ANDs every matching CodecProfile); <<$HL_BLUE>>
  if (Transcode selected?) then (yes)
    :A second request sizes the transcode with the detected bitrate; <<$HL_AMBER>>
  endif
}

partition "4. Start" {
  :WebGPUPlayer.play consumes the stock-profile proof; <<$HL_NAVY>>
  if (Augmented, DirectPlay or DirectStream,\nand the stock profile does not cover the source?) then (yes)
    :Set currentPlaybackRequiresSourceRenegotiation; <<$HL_RED>>
  endif
  if (Engine eligibility within 25 s?) then (eligible)
    :Custom pipeline; <<$HL_GREEN>>
    stop
  elseif (Renegotiation flag set?) then (no)
    :The add-on's HTML player plays the same source
    in the same session; <<$HL_AMBER>>
    stop
  else (yes)
    :Raise PlayerEvent.Error; the error retry ladder
    renegotiates with isRetry, so step 2 returns the stock profile; <<$HL_RED>>
    stop
  endif
}
@enduml
